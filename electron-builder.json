{
  "appId": "com.metahumanz.pacilread",
  "productName": "PacilRead",
  "directories": {
    "output": "release"
  },
  "files": [
    "dist/**/*",
    "dist-electron/**/*"
  ],
  "publish": {
    "provider": "github",
    "owner": "Metahumanz",
    "repo": "PacilRead",
    "releaseType": "release"
  },
  "artifactName": "${productName}-${version}-Setup.${ext}",
  "win": {
    "target": "nsis",
    "icon": "public/icon.png"
  },
  "mac": {
    "target": "dmg",
    "icon": "public/icon.png"
  },
  "linux": {
    "target": "AppImage",
    "icon": "public/icon.png"
  },
  "nsis": {
    "oneClick": false,
    "allowToChangeInstallationDirectory": true,
    "createDesktopShortcut": false
  }
}
